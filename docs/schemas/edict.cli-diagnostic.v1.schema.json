{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/schemas/edict/cli-diagnostic/v1",
  "title": "Edict CLI Diagnostic v1",
  "description": "JSONL diagnostic record emitted to stderr for source and CLI input errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "command", "severity", "stage", "kind", "input"],
  "properties": {
    "schema": {
      "const": "edict.cli.diagnostic/v1"
    },
    "type": {
      "const": "diagnostic"
    },
    "command": {
      "enum": ["check", "project", "build"]
    },
    "severity": {
      "enum": ["error"]
    },
    "stage": {
      "enum": ["parse", "semantic", "cli", "surfaceValidation", "resolve", "typeCheck", "lowerCore"]
    },
    "kind": {
      "type": "string",
      "description": "Stable failure-kind discriminator for the originating stage."
    },
    "input": {
      "$ref": "#/$defs/inputDescriptor"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "0-based UTF-8 byte offsets into the source; end is exclusive."
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based JSONL request-record line when present; not a source line."
    },
    "message": {
      "type": "string",
      "description": "Human-readable source or CLI error detail carried inside a JSON string field."
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "column"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Canonical source path and 1-based source line and Unicode-scalar column for application-build source diagnostics."
    }
  },
  "$defs": {
    "inputDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
